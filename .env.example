SUPABASE_URL=###
SUPABASE_KEY=###
# S-08 account deletion (FR-011). The Supabase SECRET / service-role key (sb_secret_... or the
# legacy service_role JWT). It BYPASSES ROW-LEVEL SECURITY — never expose it client-side, never
# commit it, and prefer a dedicated rotatable key for this backend.
# Read by exactly one module: src/lib/supabase-admin.ts (enforced by an ESLint fence).
# Local: copy the service_role key from `npx supabase status`. Prod: set it as a Cloudflare Worker
# secret (`npx wrangler secret put SUPABASE_SECRET_KEY`).
# Optional: when unset, account deletion fails closed (503 + "unavailable") and nothing else breaks.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=###
OPENAI_MODEL=###
POSTHOG_API_KEY=###
POSTHOG_HOST=https://eu.i.posthog.com
OBSERVABILITY_ID_SALT=###
# Optional dev-only guard for the F-01 smoke route (src/pages/api/observability/smoke.ts).
# Leave UNSET in production: the route 404s unless this is set AND the request token matches it.
OBSERVABILITY_SMOKE_TOKEN=
# S-06 generation abuse guards (FR-012). Both optional — unset means the built-in defaults
# (100 per user per UTC day, 500 product-wide per rolling hour). These are abuse protection,
# NOT billing or a paywall; raise them if a launch spike trips the ceiling.
GENERATION_DAILY_LIMIT=
GENERATION_HOURLY_CEILING=
PUBLIC_POSTHOG_KEY=###
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Google sign-in (Supabase external OAuth provider). Create a Google Cloud OAuth 2.0 "Web application"
# client and paste its credentials here. These are read by the local Supabase container (config.toml
# uses env() substitution) when you run `npx supabase start`, so export them into your shell / source
# this file before starting Supabase. In production set them in the hosted Supabase dashboard —
# and set the CLIENT ID as a Cloudflare Worker var too (see README "Google sign-in").
# Both optional, and deliberately left EMPTY rather than carrying a ### placeholder: the app treats
# a blank client id as "Google is not configured" and hides the sign-in button rather than offering
# one that can only dead-end. A copied .env.example must therefore read as unconfigured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
