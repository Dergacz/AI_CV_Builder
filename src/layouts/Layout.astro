---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { getMessages } from "@/lib/i18n/messages";
import type { UiLocale } from "@/lib/i18n/locales";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  locale?: UiLocale;
  title?: string;
}

const locale = Astro.props.locale ?? Astro.locals.locale;
const messages = getMessages(locale);
const { title = "AI CV Builder" } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <link rel="icon" type="image/png" href="/favicon.png?v=3" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
    <title>{title}</title>
  </head>
  <body>
    {
      missingConfigs.map((cfg) => (
        <Banner variant="error">
          <strong>{messages.shell.configBanner.warningPrefix}</strong>{" "}
          {messages.shell.configBanner.messages[cfg.name] ?? cfg.message}
          {cfg.docsUrl && (
            <>
              {" "}
              <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
                {cfg.docsLabel ?? messages.shell.configBanner.docsFallback}
              </a>
              .
            </>
          )}
        </Banner>
      ))
    }
    <slot />
    <script>
      // Cookieless PostHog init + browser error-hook scaffold. No-op when PUBLIC_POSTHOG_KEY is
      // unset; emits no funnel events (those land in S-01). See src/lib/observability/client.browser.ts.
      import { initClientObservability, installClientSmokeTrigger } from "@/lib/observability/client.browser";

      initClientObservability();
      // DEV-only proof-of-life trigger; no-op in production builds. Call window.__obsSmoke() in devtools.
      installClientSmokeTrigger();
    </script>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
