---
import Layout from "@/layouts/Layout.astro";
import SavedCvView from "@/components/cv/SavedCvView";
import { createClient } from "@/lib/supabase";
import { getCv } from "@/lib/services/cv-repository";

// Route is already auth-protected by middleware (PROTECTED_ROUTES includes "/cv").
// We still resolve the verified user here and load only an owned CV; RLS is the guard.
const { id } = Astro.params;
const supabase = createClient(Astro.request.headers, Astro.cookies);

if (!supabase || !id) {
  return Astro.redirect("/dashboard");
}

const {
  data: { user },
} = await supabase.auth.getUser();
if (!user) {
  return Astro.redirect("/auth/signin");
}

let cv;
try {
  cv = await getCv(supabase, user.id, id);
} catch {
  // Invalid id (e.g. non-uuid) or transient DB error — send back to the library.
  return Astro.redirect("/dashboard");
}

if (!cv) {
  return Astro.redirect("/dashboard");
}
---

<Layout title={cv.title}>
  <main class="min-h-screen bg-slate-50 px-5 py-6 text-slate-950 sm:px-8">
    <div class="mx-auto max-w-4xl">
      <header class="border-b border-slate-200 pb-5">
        <a href="/dashboard" class="text-sm font-semibold text-emerald-700 hover:underline">Back to workspace</a>
        <p class="mt-8 text-sm font-semibold text-teal-700">Saved CV</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">
          {cv.title}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700">
          Edit any section and save your changes. Updates overwrite this saved CV.
        </p>
      </header>

      <div class="py-8">
        <SavedCvView
          client:only="react"
          cvId={cv.id}
          title={cv.title}
          draft={cv.draft}
          answers={cv.sourceSnapshot.answers}
        />
      </div>
    </div>
  </main>
</Layout>
