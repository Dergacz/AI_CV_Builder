---
import { z } from "zod";
import Layout from "@/layouts/Layout.astro";
import SavedCvView from "@/components/cv/SavedCvView";
import { createClient, safeGetUser } from "@/lib/supabase";
import { getMessages } from "@/lib/i18n/messages";
import { scheduleErrorReport } from "@/lib/observability/schedule";
import { getCv } from "@/lib/services/cv-repository";

// Route is already auth-protected by middleware (PROTECTED_ROUTES includes "/cv").
// We still resolve the verified user here and load only an owned CV; RLS is the guard.
const { id } = Astro.params;
const locale = Astro.locals.locale;
const copy = getMessages(locale).cvPages.saved;
const supabase = createClient(Astro.request.headers, Astro.cookies);

// Validate the id shape BEFORE touching the DB, mirroring `api/cv/[id].ts`. This is what lets the
// catch below stay meaningful: a malformed id is user input (silent redirect, no report), whereas a
// throw from a well-formed id is our defect and worth reporting. Previously both collapsed here.
if (!supabase || !id || !z.uuid().safeParse(id).success) {
  return Astro.redirect("/dashboard");
}

const user = await safeGetUser(supabase, Astro.locals);
if (!user) {
  return Astro.redirect("/auth/signin");
}

let cv;
try {
  cv = await getCv(supabase, user.id, id);
} catch (error) {
  // S-07 (added in review): the user is bounced to the library with no message, so they cannot
  // report this themselves — without the report it is completely invisible.
  scheduleErrorReport(error, { error_location: "pages/cv/[id]:getCv" }, Astro.locals);
  return Astro.redirect("/dashboard");
}

if (!cv) {
  return Astro.redirect("/dashboard");
}
---

<Layout locale={locale} title={cv.title}>
  <main class="min-h-screen bg-slate-50 px-5 py-6 text-slate-950 sm:px-8">
    <div class="mx-auto max-w-4xl">
      <header class="border-b border-slate-200 pb-5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <a href="/dashboard" class="text-sm font-semibold text-emerald-700 hover:underline">
            {copy.backToWorkspace}
          </a>
        </div>
        <p class="mt-8 text-sm font-semibold text-teal-700">{copy.eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">
          {cv.title}
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700">{copy.description}</p>
      </header>

      <div class="py-8">
        <SavedCvView
          client:only="react"
          cvId={cv.id}
          title={cv.title}
          draft={cv.draft}
          answers={cv.sourceSnapshot.answers}
          locale={locale}
        />
      </div>
    </div>
  </main>
</Layout>
