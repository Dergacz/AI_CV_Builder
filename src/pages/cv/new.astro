---
import QuestionnaireFlow from "@/components/cv/QuestionnaireFlow";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Start CV">
  <main class="min-h-screen bg-slate-50 px-5 py-6 text-slate-950 sm:px-8">
    <div class="mx-auto max-w-4xl">
      <header class="border-b border-slate-200 pb-5">
        <a href="/dashboard" class="text-sm font-semibold text-emerald-700 hover:underline">Back to workspace</a>
        <p class="mt-8 text-sm font-semibold text-teal-700">Guided questionnaire</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">
          Build your CV from simple answers
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-700">
          Answer in everyday language, then review what you provided. This step captures your source details only; draft
          generation and saving come in later slices.
        </p>
      </header>

      <div class="py-8">
        <QuestionnaireFlow client:load />
      </div>
    </div>
  </main>
</Layout>
