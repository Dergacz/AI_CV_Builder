---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Sign in">
  <main class="flex min-h-screen items-center justify-center bg-slate-50 px-5 py-10 text-slate-950 sm:px-8">
    <section class="grid w-full max-w-5xl gap-8 lg:grid-cols-[minmax(0,0.95fr)_24rem] lg:items-center">
      <div class="max-w-2xl">
        <a href="/" class="text-base font-semibold text-slate-950">AI CV Builder</a>
        <p class="mt-8 text-sm font-semibold text-teal-700">Account access</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">
          Sign in to your CV workspace
        </h1>
        <p class="mt-5 text-base leading-7 text-slate-700">
          Continue from your protected workspace and prepare for the guided CV flow.
        </p>
      </div>

      <div class="w-full rounded-lg border border-slate-200 bg-white p-6 text-slate-950 shadow-xl sm:p-8">
        <h2 class="mb-2 text-2xl font-semibold text-slate-950">Sign in</h2>
        <p class="mb-6 text-sm leading-6 text-slate-600">Use the email and password for your AI CV Builder account.</p>
        <SignInForm serverError={error} client:load />
        <p class="mt-4 text-center text-sm text-slate-600">
          Don't have an account? <a href="/auth/signup" class="font-medium text-emerald-700 hover:underline">Sign up</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
