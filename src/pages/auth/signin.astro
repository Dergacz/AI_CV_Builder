---
import { CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import SignInForm from "@/components/auth/SignInForm";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton";
import { getAuthErrorMessage, resolveAuthErrorCode } from "@/lib/i18n/auth-errors";
import { getAuthNoticeMessage, isAuthNoticeCode } from "@/lib/i18n/auth-notices";
import { getMessages } from "@/lib/i18n/messages";

const locale = Astro.locals.locale;
const messages = getMessages(locale);
const content = messages.auth.signin;
const error = Astro.url.searchParams.get("error");
const serverError = error ? getAuthErrorMessage(locale, resolveAuthErrorCode(error, "signin_failed")) : null;
// Success channel (S-10): a confirmation link opened on a device that did not sign up lands here.
// Unlike errors there is no fallback code — an unrecognized `?notice=` renders nothing at all.
const notice = Astro.url.searchParams.get("notice");
const serverNotice = isAuthNoticeCode(notice) ? getAuthNoticeMessage(locale, notice) : null;
---

<Layout locale={locale} title={content.title}>
  <main class="flex min-h-screen items-center justify-center bg-slate-50 px-5 py-10 text-slate-950 sm:px-8">
    <section class="grid w-full max-w-5xl gap-8 lg:grid-cols-[minmax(0,0.95fr)_24rem] lg:items-center">
      <div class="max-w-2xl">
        <div class="flex items-center justify-between gap-4">
          <a href="/" class="text-base font-semibold text-slate-950">{messages.auth.brand}</a>
          <LanguageSwitcher locale={locale} />
        </div>
        <p class="mt-8 text-sm font-semibold text-teal-700">{content.eyebrow}</p>
        <h1 class="mt-4 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">
          {content.heading}
        </h1>
        <p class="mt-5 text-base leading-7 text-slate-700">{content.description}</p>
      </div>

      <div class="w-full rounded-lg border border-slate-200 bg-white p-6 text-slate-950 shadow-xl sm:p-8">
        <h2 class="mb-2 text-2xl font-semibold text-slate-950">{content.formTitle}</h2>
        <p class="mb-6 text-sm leading-6 text-slate-600">{content.formDescription}</p>
        {
          serverNotice && (
            <p class="mb-6 flex items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-800">
              <CircleCheck className="size-4 shrink-0" />
              {serverNotice}
            </p>
          )
        }
        <SignInForm locale={locale} serverError={serverError} client:only="react" />
        <div class="my-6 flex items-center gap-3 text-xs text-slate-400">
          <span class="h-px flex-1 bg-slate-200"></span>
          {messages.auth.google.divider}
          <span class="h-px flex-1 bg-slate-200"></span>
        </div>
        <GoogleSignInButton locale={locale} intent="signin" client:only="react" />
        <p class="mt-4 text-center text-sm text-slate-600">
          {content.alternatePrompt}{" "}
          <a href="/auth/signup" class="font-medium text-emerald-700 hover:underline">{content.alternateLink}</a>
        </p>
      </div>
    </section>
  </main>
</Layout>
