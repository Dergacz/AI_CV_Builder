---
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  version: string;
  lastUpdated: string;
  versionLabel: string;
  lastUpdatedLabel: string;
  reviewNotice: string;
  englishNote: string;
}

const { title, version, lastUpdated, versionLabel, lastUpdatedLabel, reviewNotice, englishNote } = Astro.props;
---

<article class:list={[cn("mx-auto w-full max-w-3xl px-5 py-10 text-slate-950 sm:px-8 sm:py-14")]}>
  <header class="border-b border-slate-200 pb-6">
    <p class="text-sm font-semibold text-emerald-700">{versionLabel}: {version}</p>
    <h1 class="mt-3 text-4xl leading-tight font-semibold text-slate-950 sm:text-5xl">{title}</h1>
    <p class="mt-4 text-sm text-slate-600">{lastUpdatedLabel}: {lastUpdated}</p>
  </header>

  <div class="mt-6 space-y-3">
    <p class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm leading-6 text-amber-950">
      {reviewNotice}
    </p>
    <p class="rounded-md border border-slate-200 bg-white px-4 py-3 text-sm leading-6 text-slate-700">
      {englishNote}
    </p>
  </div>

  <div class="mt-8 space-y-8 text-base leading-7 text-slate-700">
    <slot />
  </div>
</article>
