+import type { SupabaseClient } from "@supabase/supabase-js";
+
+import type { Database } from "@/db/database.types";
+
+/**
+ * Saved-CV tag data access.
+ *
+ * Same shape as `cv-repository`: thin typed queries, no HTTP, no envelope. Owner
+ * identity is supplied by the caller from the verified `auth.getUser()` id and
+ * applied to every query. Functions throw on DB error; the route maps to buckets.
+ */
+
+type TypedSupabaseClient = SupabaseClient<Database>;
+
+export interface CvTag {
+  id: string;
+  cvId: string;
+  label: string;
+}
+
+interface TagRow {
+  id: string;
+  cv_id: string;
+  label: string;
+}
+
+const TAG_COLUMNS = "id, cv_id, label" as const;
+
+function mapTag(row: TagRow): CvTag {
+  return { id: row.id, cvId: row.cv_id, label: row.label };
+}
+
+/** List every tag the owner has attached to any of their CVs. */
+export async function listTags(supabase: TypedSupabaseClient, userId: string): Promise<CvTag[]> {
+  const { data, error } = await supabase.from("cv_tags").select(TAG_COLUMNS).eq("user_id", userId).order("label");
+  if (error) {
+    throw error;
+  }
+  return data.map(mapTag);
+}
+
+/** Attach a label to an owned CV. Duplicate (cv_id, label) pairs are ignored. */
+export async function addTag(
+  supabase: TypedSupabaseClient,
+  userId: string,
+  cvId: string,
+  label: string,
+): Promise<CvTag | null> {
+  const { data, error } = await supabase
+    .from("cv_tags")
+    .upsert({ user_id: userId, cv_id: cvId, label }, { onConflict: "cv_id,label", ignoreDuplicates: true })
+    .select(TAG_COLUMNS)
+    .maybeSingle();
+  if (error) {
+    throw error;
+  }
+  return data ? mapTag(data) : null;
+}
