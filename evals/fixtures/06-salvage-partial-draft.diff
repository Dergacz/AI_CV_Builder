Subject: fix(generation): salvage a partially valid draft instead of failing outright
Description:
  "Generation failed, please try again" is our most-reported complaint. In most of
  the reported cases the model returned a perfectly usable summary and skills list
  and only one malformed section (usually an experience entry with an empty
  description). Throwing the whole draft away and asking the user to retry the
  questionnaire is a bad trade. This drops the sections that fail validation,
  re-validates, and returns the rest with a `low_confidence` warning so the editor
  still flags it. Covered by a new test.

diff --git a/src/lib/services/cv-generation.ts b/src/lib/services/cv-generation.ts
index 9f3c771..b1d7e05 100644
--- a/src/lib/services/cv-generation.ts
+++ b/src/lib/services/cv-generation.ts
@@ -186,6 +186,42 @@ function stripNulls(value: unknown): unknown {
   return value;
 }
 
+/**
+ * Best-effort repair of a draft that failed validation.
+ *
+ * Empties every array section zod complained about and backfills a minimal summary,
+ * so one malformed entry doesn't cost the user the whole draft. Returns the repaired
+ * object for re-validation; the caller decides whether the result is usable.
+ */
+function repairDraft(draft: Record<string, unknown>, issues: { path: PropertyKey[] }[]): Record<string, unknown> {
+  const sections = { ...((draft.sections ?? {}) as Record<string, unknown>) };
+  for (const issue of issues) {
+    const [root, section] = issue.path;
+    if (root !== "sections" || typeof section !== "string") {
+      continue;
+    }
+    sections[section] = section === "summary" ? { body: "Draft summary unavailable." } : [];
+  }
+  return { ...draft, sections };
+}
+
+/** Append the advisory warning that marks a repaired draft in the editor. */
+function withLowConfidence(draft: GeneratedCvDraft): GeneratedCvDraft {
+  if (draft.warnings.some((warning) => warning.code === "low_confidence")) {
+    return draft;
+  }
+  return {
+    ...draft,
+    warnings: [
+      ...draft.warnings,
+      { code: "low_confidence", message: "Some parts of this draft could not be generated." },
+    ],
+  };
+}
+
 function genFailed(): GenerateDraftServiceResult {
   return { ok: false, error: "generation_failed", message: generationErrorMessages.generation_failed };
 }
@@ -335,11 +371,19 @@ export async function generateCvDraft(
   const parsed = generatedCvDraftSchema.safeParse(draft);
   if (!parsed.success) {
-    // Model output did not conform to the contract; surface as a retryable generation failure.
-    // The zod issue list names draft fields and would carry content — it is deliberately not sent.
-    report(undefined, "services/cv-generation:schemaMismatch");
-    return genFailed();
+    // Model output did not conform to the contract. Try to keep the usable parts before
+    // giving up — the issue list names draft fields and is never sent anywhere.
+    const repaired = generatedCvDraftSchema.safeParse(repairDraft(draft, parsed.error.issues));
+    if (repaired.success) {
+      return { ok: true, draft: withLowConfidence(repaired.data) };
+    }
+    report(undefined, "services/cv-generation:schemaMismatch");
+    return genFailed();
   }
 
   return { ok: true, draft: parsed.data };
 }
